{
  "name": "@witsauth/react-native-client",
  "version": "1.0.0",
  "description": "Official React Native client library (Expo and Bare React Native CLI) for integrating WitsAuth OAuth 2.0 + PKCE authentication on Android and iOS.",
  "main": "./dist/index.umd.js",
  "module": "./dist/index.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.es.js",
      "require": "./dist/index.umd.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc -p tsconfig.build.json",
    "test": "vitest run"
  },
  "keywords": [
    "react-native",
    "expo",
    "android",
    "ios",
    "witsauth",
    "auth",
    "oauth2",
    "pkce"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "peerDependencies": {
    "axios": "^1.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native": ">=0.72.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    },
    "react-native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "axios": "^1.18.1",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
